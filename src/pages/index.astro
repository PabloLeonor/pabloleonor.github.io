---
import Layout from '../layouts/Layout.astro';
import { getCollection, getEntry, render } from 'astro:content';

const entry = await getEntry('paginas', 'inicio');
const Content = entry ? (await render(entry)).Content : null;

// Solo entradas del blog (no borradores), las 3 más recientes.
const posts = (await getCollection('posts', (p) => !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const fmt = (d: Date) => d.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Layout title="Inicio" path="Inicio">
  {entry && entry.data.title && <h1 class="hello">{entry.data.title}</h1>}
  {Content && <div class="prose intro"><Content /></div>}

  {posts.length > 0 && (
    <>
      <h2>Últimas entradas</h2>
      <ul class="posts">
        {posts.map((p) => (
          <li class="post">
            <h3><a href={`/blog/${p.id}/`}>{p.data.title}</a></h3>
            <time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
            {p.data.description && <p>{p.data.description}</p>}
          </li>
        ))}
      </ul>
    </>
  )}
</Layout>
