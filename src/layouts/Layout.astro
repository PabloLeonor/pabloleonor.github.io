---
import '../styles/xp.css';
import site from '../data/site.json';

interface Props {
  title: string;
  /** Ruta que se muestra en la barra de dirección, p. ej. "Blog\\Mi entrada" */
  path?: string;
  description?: string;
  wide?: boolean;
}

const { title, path, description = site.tagline, wide = false } = Astro.props;
const pathname = Astro.url.pathname;

const nav = [
  { href: '/', label: 'Inicio', match: (p: string) => p === '/' },
  { href: '/proyectos/', label: 'Proyectos', match: (p: string) => p.startsWith('/proyectos') },
  { href: '/blog/', label: 'Blog', match: (p: string) => p.startsWith('/blog') },
  { href: '/experiencia/', label: 'Experiencia', match: (p: string) => p.startsWith('/experiencia') },
  { href: '/sobre-mi/', label: 'Sobre mí', match: (p: string) => p.startsWith('/sobre-mi') },
  { href: '/contacto/', label: 'Contacto', match: (p: string) => p.startsWith('/contacto') },
];

const siteName = site.name || 'Portfolio';
const fullTitle = title === 'Inicio' ? siteName : `${title} – ${siteName}`;
const hasLinks = Boolean(site.github || site.linkedin);
const hasDetails = Boolean(site.name || site.role || site.availability);
const addr = `C:\\Portfolio\\${path ?? title}`;
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{fullTitle}</title>
  {description && <meta name="description" content={description}>}
  <script is:inline>
    try {
      var t = localStorage.getItem('theme');
      if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
    } catch (e) {}
  </script>
</head>
<body>
<div class="desk">
<main class="win" aria-label="Portfolio">
  <div class="title">
    <span class="ico" aria-hidden="true"></span>
    <span class="name">{fullTitle}</span>
    <span class="ctl" aria-hidden="true"><span>–</span><span>❐</span><span>×</span></span>
  </div>
  <div class="menubar">
    <div class="menu-archivo">
      <button type="button" id="archivo-btn" aria-haspopup="menu" aria-expanded="false" aria-controls="archivo-menu">Archivo</button>
      <ul class="menu-list" id="archivo-menu" role="menu" hidden>
        {nav.map((n) => {
          const cur = n.match(pathname);
          return (
            <li role="none">
              <a role="menuitem" href={n.href} aria-current={cur ? 'page' : undefined}>
                <span class="chk" aria-hidden="true">{cur ? '✓' : ''}</span>{n.label}
              </a>
            </li>
          );
        })}
        {hasLinks && <li class="sep" role="separator"></li>}
        {site.github && <li role="none"><a role="menuitem" href={site.github} rel="noopener"><span class="chk" aria-hidden="true"></span>GitHub</a></li>}
        {site.linkedin && <li role="none"><a role="menuitem" href={site.linkedin} rel="noopener"><span class="chk" aria-hidden="true"></span>LinkedIn</a></li>}
        {hasDetails && <li class="sep" role="separator"></li>}
        {hasDetails && (
          <li class="info" role="presentation">
            {site.name && <b>{site.name}</b>}
            {site.role && <span>{site.role}</span>}
            {site.availability && <span>{site.availability}</span>}
          </li>
        )}
      </ul>
    </div>
    <button type="button" id="theme">Ver: cambiar tema</button>
    <a href="/contacto/">Ayuda: contactar</a>
  </div>
  <div class="addr"><label for="path">Dirección</label><output id="path">{addr}</output></div>
  <div class="body">
    <nav class="pane" aria-label="Menú principal">
      <details class="grp" open>
        <summary>Tareas del portfolio</summary>
        <ul>
          {nav.map((n) => (
            <li><a href={n.href} aria-current={n.match(pathname) ? 'page' : undefined}><i aria-hidden="true">📁</i><span>{n.label}</span></a></li>
          ))}
        </ul>
      </details>
      {hasLinks && (
        <details class="grp" open>
          <summary>Otros sitios</summary>
          <ul>
            {site.github && <li><a href={site.github} rel="noopener"><i aria-hidden="true">📁</i><span>GitHub</span></a></li>}
            {site.linkedin && <li><a href={site.linkedin} rel="noopener"><i aria-hidden="true">📁</i><span>LinkedIn</span></a></li>}
          </ul>
        </details>
      )}
      {hasDetails && (
        <details class="grp" open>
          <summary>Detalles</summary>
          <div class="det">
            {site.name && <b>{site.name}</b>}
            {site.role}
            {site.role && site.availability && <br>}
            {site.availability}
          </div>
        </details>
      )}
    </nav>
    <div class="main" id="main">
      <div class={wide ? 'page wide' : 'page'}>
        <slot />
      </div>
    </div>
  </div>
</main>
</div>
<div class="task">
  <a class="start" href="/">inicio</a>
  <span class="tbtn">{title} – Portfolio</span>
  <span class="clock" id="clock"></span>
</div>
<script>
  function tick() {
    const el = document.getElementById('clock');
    if (el) el.textContent = new Date().toLocaleTimeString('es', { hour: '2-digit', minute: '2-digit' });
  }
  tick();
  setInterval(tick, 30000);

  // Menú "Archivo" (solo visible en pantallas pequeñas)
  const archivoBtn = document.getElementById('archivo-btn');
  const archivoMenu = document.getElementById('archivo-menu');
  const archivoItems = () =>
    Array.from(archivoMenu?.querySelectorAll<HTMLElement>('a[role="menuitem"]') ?? []);
  function setArchivo(open: boolean) {
    if (!archivoMenu || !archivoBtn) return;
    archivoMenu.hidden = !open;
    archivoBtn.setAttribute('aria-expanded', String(open));
  }
  archivoBtn?.addEventListener('click', () => setArchivo(archivoMenu?.hidden ?? false));
  archivoBtn?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      setArchivo(true);
      archivoItems()[0]?.focus();
    }
  });
  document.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('.menu-archivo')) setArchivo(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && archivoMenu && !archivoMenu.hidden) {
      setArchivo(false);
      archivoBtn?.focus();
    }
  });
  archivoMenu?.addEventListener('keydown', (e) => {
    const items = archivoItems();
    const i = items.indexOf(document.activeElement as HTMLElement);
    if (e.key === 'ArrowDown') { e.preventDefault(); items[(i + 1) % items.length]?.focus(); }
    if (e.key === 'ArrowUp') { e.preventDefault(); items[(i - 1 + items.length) % items.length]?.focus(); }
  });
  matchMedia('(min-width:721px)').addEventListener('change', (e) => { if (e.matches) setArchivo(false); });

  document.getElementById('theme')?.addEventListener('click', () => {
    const r = document.documentElement;
    const dark = r.dataset.theme
      ? r.dataset.theme === 'dark'
      : matchMedia('(prefers-color-scheme:dark)').matches;
    r.dataset.theme = dark ? 'light' : 'dark';
    try { localStorage.setItem('theme', r.dataset.theme); } catch (e) {}
  });
</script>
</body>
</html>
